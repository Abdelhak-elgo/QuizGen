# ── Base de données PostgreSQL (app) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quizgen
DB_USER=quizgen
DB_PASS=CHANGE_ME_db_password

# ── Keycloak ─────────────────────────────────────────────────────────────────
KC_DB_PASS=CHANGE_ME_keycloak_db_password
KC_ADMIN_PASS=CHANGE_ME_keycloak_admin_password
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=quizgen
VITE_KEYCLOAK_CLIENT_ID=quizgen-frontend
KEYCLOAK_ISSUER_URL=http://localhost:8180

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASS=CHANGE_ME_redis_password

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_password

# ── LLM : hors ligne (Ollama) ou en ligne (API) ─────────────────────────────
# offline : Ollama local, aucune donnée ne quitte la machine (lent sur CPU)
# online  : API distante (rapide) — le texte des documents est envoyé au fournisseur
LLM_MODE=offline
# Démarre les conteneurs Ollama (à vider en mode online pour économiser la RAM)
COMPOSE_PROFILES=offline

# Mode online uniquement. Le protocole est déduit de LLM_API_BASE_URL :
#   Anthropic : LLM_API_BASE_URL=https://api.anthropic.com           LLM_MODEL=claude-haiku-4-5-20251001
#   OpenAI    : LLM_API_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
#   Mistral   : LLM_API_BASE_URL=https://api.mistral.ai/v1           LLM_MODEL=mistral-small-latest
#   NVIDIA    : LLM_API_BASE_URL=https://integrate.api.nvidia.com/v1 LLM_MODEL=meta/llama-3.1-70b-instruct
#   (tout autre point d'accès compatible OpenAI /chat/completions : Groq, OpenRouter…)
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE_URL=

# ── Ollama (mode offline) ────────────────────────────────────────────────────
# Modèle utilisé : mistral (pull via scripts/setup-ollama.sh)
OLLAMA_MODEL=mistral
# Ollama installé nativement sur l'hôte (Windows/macOS) plutôt qu'en conteneur :
# OLLAMA_URL=http://host.docker.internal:11434
