# ============================================================
# QuizGen — Variables d'environnement (TEMPLATE)
# Copier en .env et adapter les valeurs
# cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=quizgen
POSTGRES_USER=quizgen_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCUMENTS=quizgen-documents
MINIO_BUCKET_EXPORTS=quizgen-exports

# ---- Spring Boot API ----
SPRING_PORT=8080
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRATION=86400000

# ---- FastAPI NLP ----
FASTAPI_PORT=8000

# ---- Ollama / Mistral ----
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral
