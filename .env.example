# ============================================================
# QuizGen — Environment Variables
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=quizgen
POSTGRES_DB_KEYCLOAK=keycloak
POSTGRES_USER=quizgen_user
POSTGRES_PASSWORD=quizgen_secret_2025
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=redis_secret_2025
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_2025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCUMENTS=quizgen-documents
MINIO_BUCKET_EXPORTS=quizgen-exports

# ---- Ollama ----
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=quizgen
KEYCLOAK_CLIENT_ID=quizgen-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-secret

# ---- Spring API ----
SPRING_PORT=8083

# ---- FastAPI NLP ----
FASTAPI_PORT=8001